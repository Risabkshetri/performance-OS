# Supabase project → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable (or legacy "anon") key. Safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# REQUIRED. Passcode for the lock screen. Every page, read and write is blocked
# until a device enters it (remembered for a year; changing it locks all devices out).
# Without it the app stays locked. Use a long passphrase.
APP_PASSCODE=

# Owner account. After the passcode, the app signs in as this user automatically.
# Server-only: never prefix these with NEXT_PUBLIC_.
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=change-me

# Never add the service-role key here. The app does not need it.
